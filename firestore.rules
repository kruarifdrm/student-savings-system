/* ─────────────────────────────────────────────────────────────
   กฎความปลอดภัย Firestore — ระบบออมทรัพย์นักเรียน

   บทบาท
     · ครู        = บัญชี Google ที่ยืนยันอีเมลแล้ว และอยู่ในรายชื่อ isTeacher()
                    → อ่านและเขียนได้
     · ผู้ปกครอง  = บัญชี anonymous ที่แอปสร้างให้อัตโนมัติ → อ่านอย่างเดียว
     · คนไม่ล็อกอิน = อ่านหรือเขียนอะไรไม่ได้เลย

   ⚠ ต้องแก้ 2 ที่ให้ตรงกันเสมอ
     1. อีเมลใน isTeacher() ไฟล์นี้      ← ตัวคุมสิทธิ์จริง
     2. window.TEACHER_EMAILS ใน firebase-config.js  ← ใช้กับหน้าจอเท่านั้น
     ถ้าใส่ไม่ตรงกัน จะเข้าหน้าครูได้แต่บันทึกข้อมูลไม่ได้

   ต้องเปิด provider ทั้งสองแบบใน Firebase Console → Authentication → Sign-in method
     · Google      (สำหรับครู)
     · Anonymous   (สำหรับผู้ปกครอง/นักเรียน)

   deploy กฎ:  firebase deploy --only firestore:rules
   ───────────────────────────────────────────────────────────── */

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    /* อ่านค่าจาก token แบบมีค่าเริ่มต้น เพราะบัญชี anonymous ไม่มีฟิลด์ email
       ถ้าอ้างตรง ๆ กฎจะ evaluation error ทุกครั้งที่ผู้ปกครองแตะข้อมูล */
    function verifiedEmail() {
      return signedIn()
             && request.auth.token.get('email_verified', false) == true
             && request.auth.token.get('email', '') != '';
    }

    /* ── อีเมลเจ้าของระบบ (คนที่ติดตั้ง) ──
       ใส่ครั้งเดียวตอนติดตั้ง แล้วไม่ต้องแก้ไฟล์นี้อีกเลย
       ครูคนอื่นเพิ่ม-ลบได้จากแท็บ "ตั้งค่า" ในแอป ซึ่งเขียนลง config/teachers

       ⚠ อีเมลนี้เป็นทางกลับเข้าระบบเสมอ แม้ถูกลบออกจากรายชื่อในแอปแล้ว
         ห้ามลบทิ้ง ไม่งั้นถ้าเผลอลบครูจนหมดจะไม่มีใครเข้าระบบได้อีก */
    function ownerEmails() {
      return [
        'kru@example.com'
      ];
    }

    /* รายชื่อครูที่แก้จากแอปได้ อยู่ที่เอกสาร config/teachers ฟิลด์ emails
       ต้องเช็ค exists() ก่อน ไม่งั้นตอนยังไม่มีเอกสารกฎจะพัง */
    function teacherEmails() {
      /* ใส่ค่าว่างไว้หนึ่งช่องเสมอ เพราะการเทียบ in กับลิสต์เปล่าทำให้กฎ
         เกิด evaluation error (ผลลัพธ์คือปฏิเสธเหมือนกัน แต่ log อ่านยาก)
         สตริงว่างไม่มีทางตรงกับอีเมลจริงอยู่แล้ว */
      return exists(/databases/$(database)/documents/config/teachers)
             ? get(/databases/$(database)/documents/config/teachers).data.get('emails', ['']).concat([''])
             : [''];
    }

    function isTeacher() {
      return verifiedEmail()
             && (request.auth.token.email in ownerEmails()
                 || request.auth.token.email in teacherEmails());
    }

    /* ── โหมดเข้มงวด (ไม่บังคับ) ──
       ปกติผู้ปกครองใช้บัญชี anonymous ที่แอปสร้างให้ แล้วอ่านได้ทุกคนที่มีลิงก์
       ถ้าอยากให้เฉพาะคนที่ระบุไว้เข้าดูได้ ให้ทำ 2 อย่าง
         1. ใส่อีเมล Google ของผู้ปกครองในรายการข้างล่างนี้
         2. เปลี่ยน  allow read: if signedIn();  เป็น  allow read: if isViewer();
            (ทั้งสองที่ใต้ /savings) แล้วปิด provider Anonymous ใน Console

       ⚠ ห้ามเอาอีเมลผู้ปกครองไปใส่ใน isTeacher() เด็ดขาด เพราะ isTeacher()
         คุมสิทธิ์ "เขียน" ด้วย ผู้ปกครองจะแก้ยอดเงินได้ทันที */
    function isViewer() {
      return isTeacher()
             || (verifiedEmail()
                 && request.auth.token.email in [
                      // 'parent1@gmail.com',
                      // 'parent2@gmail.com'
                    ]);
    }

    /* รายชื่อครู (ถ้าอยากคุมจากฐานข้อมูลแทนการแก้ไฟล์นี้)
       เอกสาร config/teachers เก็บฟิลด์ emails เป็น list ของอีเมล
       หมายเหตุ: ตัวคุมสิทธิ์จริงยังเป็น isTeacher() ด้านบนเสมอ

       อ่านได้เฉพาะครู — ไม่ให้ผู้ปกครอง/คนทั่วไปดึงอีเมลครูไปได้
       ถ้าอ่านไม่ได้ แอปจะถอยไปใช้ window.TEACHER_EMAILS ใน firebase-config.js เอง */
    match /config/{doc} {
      allow read, write: if isTeacher();
    }

    /* ข้อมูลออมทรัพย์อยู่ใน savings/app และ subcollection ใต้เอกสารนั้น
       (students, transactions) Firestore ไม่ cascade ลง subcollection เอง
       ต้องมี match /{document=**} ครอบด้วย */
    match /savings/{docId} {
      allow read:  if signedIn();
      allow write: if isTeacher();

      match /{document=**} {
        allow read:  if signedIn();
        allow write: if isTeacher();
      }
    }

    /* ที่เหลือทั้งโปรเจกต์ปิดไว้ */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
